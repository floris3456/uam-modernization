{
  // Scouting index only. Exclusions improve relevance and minimize indexed data; they are not access controls.
  "extra_ignore_patterns": [
    "UAM-overdracht-INTERN-*",
    "UAM-overdracht-INTERN-*/**",
    "raw-database-evidence",
    "raw-database-evidence/**",
    "research/**",
    "evidence/**",
    "docs/work/archive/**",
    "docs/work/handoffs/**"
  ],
  "watch_extra_ignore": [
    "UAM-overdracht-INTERN-*",
    "UAM-overdracht-INTERN-*/**",
    "raw-database-evidence",
    "raw-database-evidence/**",
    "research/**",
    "evidence/**",
    "docs/work/archive/**",
    "docs/work/handoffs/**"
  ],
  "freshness_mode": "strict",
  "strict_timeout_ms": 15000
}
