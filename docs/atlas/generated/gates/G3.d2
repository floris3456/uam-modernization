direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "G3 · Source and cursor tracking\nGate: open. Implementation: blocked. Depends on: G2." {
  class: normal
  link: "G3.html#main"
}
decision: "1. Humans decide\nApprove discovery limits and how source replacement is handled." {
  class: normal
  link: "G3.html#human-decisions"
}
work: "2. Allowed work\nGive each source a stable identity and advance only with native IDs." {
  class: normal
  link: "G3.html#allowed-work"
}
evidence: "3. CLI proof\nTest rename, replacement, duplicates, crashes, ties, and replay." {
  class: normal
  link: "G3.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow privacy transformation of correctly identified records." {
  class: normal
  link: "G3.html#pass-condition"
}
stop: "Stop or hold\nStop for mixed sources, timestamp cursors, skipped data, or duplicates." {
  class: stop
  link: "G3.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
