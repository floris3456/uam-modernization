direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "AG-11 · Outage and disk pressure\nGate: open. Implementation: blocked. Depends on: G5, AG-09, AG-10." {
  class: normal
  link: "AG-11.html#main"
}
decision: "1. Humans decide\nApprove storage limits, pause rules, recovery goals, and user signals." {
  class: normal
  link: "AG-11.html#human-decisions"
}
work: "2. Allowed work\nPause safely under pressure and resume without hiding loss or corruption." {
  class: normal
  link: "AG-11.html#allowed-work"
}
evidence: "3. CLI proof\nFill disks, extend outages, reconnect fleets, and measure recovery." {
  class: normal
  link: "AG-11.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow lifecycle and extended environment qualification." {
  class: normal
  link: "AG-11.html#pass-condition"
}
stop: "Stop or hold\nStop for silent loss, corruption, endless growth, or false health." {
  class: stop
  link: "AG-11.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
