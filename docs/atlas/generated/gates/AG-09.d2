direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "AG-09 · Durable server intake\nGate: open. Implementation: blocked. Depends on: G5, AG-07." {
  class: normal
  link: "AG-09.html#main"
}
decision: "1. Humans decide\nApprove receipt meaning, lease rules, retries, and quarantine ownership." {
  class: normal
  link: "AG-09.html#human-decisions"
}
work: "2. Allowed work\nDurably store bytes before receipt and give duplicates one effect." {
  class: normal
  link: "AG-09.html#allowed-work"
}
evidence: "3. CLI proof\nTest crashes, duplicate requests, expired leases, poison data, and replay." {
  class: normal
  link: "AG-09.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow database, outage, lifecycle, and migration proof work." {
  class: normal
  link: "AG-09.html#pass-condition"
}
stop: "Stop or hold\nStop for early receipts, loss, double effects, stale leases, or poison loops." {
  class: stop
  link: "AG-09.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
