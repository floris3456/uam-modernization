direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "G0 · Fictional test foundation\nGate: open. Implementation: not-started. Depends on: none." {
  class: normal
  link: "G0.html#main"
}
decision: "1. Humans decide\nName reviewers and confirm privacy rules, contracts, and experiments." {
  class: normal
  link: "G0.html#human-decisions"
}
work: "2. Allowed work\nBuild fictional data, strict contracts, and an independent checker." {
  class: normal
  link: "G0.html#allowed-work"
}
evidence: "3. CLI proof\nRepeat generation, mutations, canary scans, cleanup, and hash checks." {
  class: normal
  link: "G0.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow synthetic endpoint foundations, but never live data." {
  class: normal
  link: "G0.html#pass-condition"
}
stop: "Stop or hold\nStop for real data, unstable results, missed canaries, coupling, or residue." {
  class: stop
  link: "G0.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
