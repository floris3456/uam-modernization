direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "G1 · Windows session safety\nGate: open. Implementation: blocked. Depends on: G0." {
  class: normal
  link: "G1.html#main"
}
decision: "1. Humans decide\nApprove owners, the lab setup, and forbidden privileges." {
  class: normal
  link: "G1.html#human-decisions"
}
work: "2. Allowed work\nStart one User Host per session and isolate IPC and Task Host work." {
  class: normal
  link: "G1.html#allowed-work"
}
evidence: "3. CLI proof\nMeasure sessions, tokens, pipe access, hostile tasks, cleanup, and rollback." {
  class: normal
  link: "G1.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow the carefully bounded live Edge reading experiment." {
  class: normal
  link: "G1.html#pass-condition"
}
stop: "Stop or hold\nStop for cross-session access, extra privilege, escape, or residue." {
  class: stop
  link: "G1.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
