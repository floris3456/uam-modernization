direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "AG-12 · Data lifecycle and restore\nGate: open. Implementation: blocked. Depends on: AG-09, AG-10, AG-11." {
  class: normal
  link: "AG-12.html#main"
}
decision: "1. Humans decide\nApprove retention, deletion, restore, replay, and platform support rules." {
  class: normal
  link: "AG-12.html#human-decisions"
}
work: "2. Allowed work\nReconcile deletions and acknowledgements before restored reads resume." {
  class: normal
  link: "AG-12.html#allowed-work"
}
evidence: "3. CLI proof\nTest backup, restore, export, replay, deletion, and each Windows tuple." {
  class: normal
  link: "AG-12.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow portal and migration work on qualified lifecycle behavior." {
  class: normal
  link: "AG-12.html#pass-condition"
}
stop: "Stop or hold\nStop for visible deleted data, broken acknowledgements, or unsupported claims." {
  class: stop
  link: "AG-12.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
