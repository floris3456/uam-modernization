direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "AG-13 · Portal access and audit\nGate: open. Implementation: blocked. Depends on: AG-09, AG-12." {
  class: normal
  link: "AG-13.html#main"
}
decision: "1. Humans decide\nApprove capabilities, purposes, workflows, audit access, and accessibility." {
  class: normal
  link: "AG-13.html#human-decisions"
}
work: "2. Allowed work\nCheck current authority and record audit before every sensitive effect." {
  class: normal
  link: "AG-13.html#allowed-work"
}
evidence: "3. CLI proof\nTest routes, realms, revocation, approvals, tampering, and keyboard use." {
  class: normal
  link: "AG-13.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow governed portal use and final cutover preparation." {
  class: normal
  link: "AG-13.html#pass-condition"
}
stop: "Stop or hold\nStop for unauthorized access, missing audit, tampering, or blocked users." {
  class: stop
  link: "AG-13.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
