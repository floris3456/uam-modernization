direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "G5 · Crash-safe device storage\nGate: open. Implementation: blocked. Depends on: G3, G4." {
  class: normal
  link: "G5.html#main"
}
decision: "1. Humans decide\nApprove durability, receipt, migration, and disk-pressure rules." {
  class: normal
  link: "G5.html#human-decisions"
}
work: "2. Allowed work\nAtomically store event effects and progress, then seal exact batches." {
  class: normal
  link: "G5.html#allowed-work"
}
evidence: "3. CLI proof\nCrash every boundary and test replay, receipts, cleanup, and migration." {
  class: normal
  link: "G5.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow release, server, outage, and migration proof work." {
  class: normal
  link: "G5.html#pass-condition"
}
stop: "Stop or hold\nStop for lost events, false progress, changed replay, or early cleanup." {
  class: stop
  link: "G5.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
