direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "AG-07 · Device trust and networking\nGate: open. Implementation: blocked. Depends on: AG-06." {
  class: normal
  link: "AG-07.html#main"
}
decision: "1. Humans decide\nApprove enrollment authority, realm rules, and network support policy." {
  class: normal
  link: "AG-07.html#human-decisions"
}
work: "2. Allowed work\nEnroll, renew, revoke, and authenticate each device to one realm." {
  class: normal
  link: "AG-07.html#allowed-work"
}
evidence: "3. CLI proof\nTest cloning, revocation, proxies, VPN, expiry, and wrong realms." {
  class: normal
  link: "AG-07.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow qualified diagnostics and server communication testing." {
  class: normal
  link: "AG-07.html#pass-condition"
}
stop: "Stop or hold\nStop for cloned identity, stale access, realm confusion, or unsafe bypass." {
  class: stop
  link: "AG-07.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
