direction: right
classes: {
  normal: {
    style: {
      fill: "#f5f7fa"
      stroke: "#566273"
    }
  }
  stop: {
    style: {
      fill: "#fff2f2"
      stroke: "#8b1e1e"
      stroke-width: 2
    }
  }
}
start: "G4 · Privacy protection\nGate: open. Implementation: blocked. Depends on: G0, G2." {
  class: normal
  link: "G4.html#main"
}
decision: "1. Humans decide\nApprove the privacy ceiling and application matching rules." {
  class: normal
  link: "G4.html#human-decisions"
}
work: "2. Allowed work\nMatch applications and transform URLs before crossing the boundary." {
  class: normal
  link: "G4.html#allowed-work"
}
evidence: "3. CLI proof\nRun canaries, realm tests, matching vectors, and sink scans." {
  class: normal
  link: "G4.html#cli-evidence"
}
success: "4. Pass and unlock\nAllow only transformed events into the crash-safe outbox." {
  class: normal
  link: "G4.html#pass-condition"
}
stop: "Stop or hold\nStop for raw leakage, wrong matches, realm mixing, or missed canaries." {
  class: stop
  link: "G4.html#stop-condition"
}
start -> decision -> work -> evidence -> success
evidence -> stop: "If proof fails" {
  style: {
    stroke: "#8b1e1e"
    stroke-dash: 4
  }
}
